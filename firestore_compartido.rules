rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      // Todos los usuarios autenticados comparten los mismos listados.
      allow read, delete: if isSignedIn();

      // Los listados solo pueden contener los campos que utiliza el sistema.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'items', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      function isSignedIn() {
        return request.auth != null;
      }
    }

    // Conserva protegidos los listados anteriores guardados por usuario.
    match /users/{userId}/lists/{listId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
